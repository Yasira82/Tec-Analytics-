# ── Pi Network ────────────────────────────────────────────
NEXT_PUBLIC_PI_APP_ID=
NEXT_PUBLIC_PI_SANDBOX=false

# ── TEC Gateway ───────────────────────────────────────────
# Server-only (BFF) — the primary and correct place for the gateway URL.
API_GATEWAY_URL=https://api-gateway-production-6a68.up.railway.app
# ⚠️ Client-exposed (NEW-A) — leave EMPTY unless the client-side incomplete-payment
# fallback is required; anything set here ships in the public JS bundle.
NEXT_PUBLIC_API_GATEWAY_URL=

# ── Auth & SSO ───────────────────────────────────────────
JWT_SECRET=
# Shared secret used to verify the Hub SSO token at /api/auth/sso-callback (HS256)
SSO_SECRET=
# Cookie domain for cross-subdomain SSO (e.g. .tecosystem.app) — optional
COOKIE_DOMAIN=
NEXT_PUBLIC_SSO_DOMAIN=

# ── Inter-service (server-only) ──────────────────────────
# REQUIRED for payment routes — sent as x-internal-key to the gateway.
# Must match the value set on every backend service. NEVER expose as NEXT_PUBLIC_*.
INTERNAL_SECRET=

# ── Realtime (optional) ──────────────────────────────────
REALTIME_URL=

# ── AI (optional) ────────────────────────────────────────
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# ── Monitoring (optional) ────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
